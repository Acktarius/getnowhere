{
  "name": "gnh-desktop-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron shell for Get NowHere (embedded Vite UI + localhost Hyperswarm sidecar child)",
  "main": "main.mjs",
  "scripts": {
    "test": "node --test test/*.mjs",
    "start": "electron .",
    "start:alice": "GNH_ROLE=alice electron .",
    "start:bob": "GNH_ROLE=bob electron .",
    "start:alice:isolated": "GNH_ROLE=alice GNH_SWARM_MODE=isolated electron .",
    "start:bob:isolated": "GNH_ROLE=bob GNH_SWARM_MODE=isolated HOLEPUNCH_PORT=7902 electron .",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "package": "npm run prepare:sidecar && electron-forge package --platform=linux --arch=x64",
    "make": "npm run prepare:sidecar && electron-forge make --platform=linux --arch=x64",
    "make:win": "npm run prepare:sidecar && electron-forge make --platform=win32 --arch=x64",
    "install:app": "npm install"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "41.10.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "undici": "7.29.1",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.2",
    "browserslist": "4.29.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "@electron/packager": "20.3.0"
  }
}
