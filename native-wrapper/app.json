{
  "expo": {
    "name": "Get NowHere",
    "slug": "get-nowhere-wrapper",
    "version": "0.4.7",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b0f",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0b0f"
    },
    "assetBundlePatterns": ["assets/ui/**/*", "assets/bare/**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "im.getnowhere.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Get NowHere uses Face ID or Touch ID to unlock the app and your wallet.",
        "NSCameraUsageDescription": "Get NowHere uses the camera to scan QR codes.",
        "NSMicrophoneUsageDescription": "Get NowHere may use the microphone for future voice features.",
        "NSPhotoLibraryUsageDescription": "Get NowHere can read a QR code image or photo to share in chat.",
        "NSPhotoLibraryAddUsageDescription": "Get NowHere can save images received in chat to your photo library."
      }
    },
    "android": {
      "package": "im.getnowhere.app",
      "label": "Get NowHere",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#161922",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withGnhIosUiBundle.js",
      "./plugins/withGnhSecurity.js",
      "./plugins/withGnhBackgroundSync.js",
      "./plugins/withGnhNotifications.js",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0a0b0f"
          }
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "ff9c2ffa-612f-4ea8-a878-e97b6ce1a3a3"
      }
    }
  }
}
