{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios": {
      "distribution": "store",
      "node": "22.14.0",
      "ios": {
        "image": "sdk-55"
      }
    },
    "adhoc-ios": {
      "distribution": "internal",
      "node": "22.14.0",
      "ios": {
        "image": "sdk-55",
        "simulator": false
      }
    },

    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.14.0",
      "ios": {
        "simulator": false,
        "image": "sdk-55"
      }
    }
  },
  "submit": {
    "preview-ios": {},
    "production": {}
  }
}
