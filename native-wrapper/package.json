{
  "name": "gnh-native-wrapper",
  "version": "0.2.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "sync-ui": "node scripts/sync-ui-dist.mjs",
    "generate:icons": "bash scripts/generate-brand-icons.sh && node scripts/refresh-android-launcher.mjs",
    "prepare:android-assets": "node scripts/prepare-android-assets.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android": "node scripts/prepare-android-assets.mjs && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
