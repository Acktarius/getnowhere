{
  "name": "gnh-native-wrapper",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/pack-bare.mjs && expo start",
    "sync-ui": "node scripts/sync-ui-dist.mjs",
    "pack-bare": "node scripts/pack-bare.mjs",
    "test:bare": "node scripts/run-bare-tests.mjs",
    "generate:icons": "bash scripts/generate-brand-icons.sh && node scripts/refresh-android-launcher.mjs",
    "prepare:android-assets": "node scripts/prepare-android-assets.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android": "node scripts/prepare-android-assets.mjs && expo run:android",
    "android:release": "node scripts/build-android-release.mjs",
    "android:sign-test": "node scripts/sign-android-apk.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~55.0.23",
    "expo-asset": "~55.0.18",
    "expo-build-properties": "~55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-file-system": "~55.0.24",
    "expo-sharing": "~55.0.10",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-bare-kit": "^0.13.3",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "bare-link": "3.0.1",
    "bare-pack": "2.2.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.18",
    "uuid": "13.0.1"
  }
}
