# Local env example (copy to `.env` as needed)
# Browser web-dev only (no Electron token). Electron uses gnhDesktop from preload.
VITE_HOLEPUNCH_WS_URL=ws://127.0.0.1:7901
# Optional ntfy read token for gnh-* topics. Leave empty if topics are publicly readable.
VITE_NTFY_READ_TOKEN=
# Public HTTPS origin of poke-gateway (no trailing slash). Unset → sendPoke no-op.
# VITE_POKE_GATEWAY_URL=

# Optional desktop overrides (export in the shell before npm run desktop:*):
# GNH_SWARM_MODE=shared
# GNH_SIDECAR_TOKEN=gnh-desktop-shared
# GNH_UI_URL=http://127.0.0.1:5173
