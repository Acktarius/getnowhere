PORT=3456
DB_PATH=./poke.db

# APNs (.p8 key from Apple Developer → Keys). Topic is the iOS bundle id.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=./secrets/AuthKey.p8
APNS_BUNDLE_ID=im.getnowhere.app

# FCM HTTP v1 (Firebase service-account JSON).
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json
