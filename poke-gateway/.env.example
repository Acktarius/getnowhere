PORT=3456
DB_PATH=./poke.db

# APNs (.p8 key from Apple Developer → Keys). Topic is the iOS bundle id.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=./secrets/AuthKey.p8
APNS_BUNDLE_ID=im.getnowhere.app

# ntfy fallback (peer wake when no APNs token is registered).
NTFY_BASE_URL=https://ntfy.getnowhere.im
NTFY_PUBLISH_TOKEN=
